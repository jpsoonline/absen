rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin (pemilik aplikasi), huruf kecil. Sama dengan admin Rekap OS.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['jpsoonline@gmail.com'];
    }
    function myEmail() { return request.auth.token.email.lower(); }

    // ===== Rekap OS (tidak diubah) =====
    function licensed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/licenses/$(myEmail()))
        && get(/databases/$(database)/documents/licenses/$(myEmail())).data.status == 'active';
    }
    match /licenses/{email} {
      allow read: if request.auth != null && (isAdmin() || myEmail() == email);
      allow write: if isAdmin();
    }
    match /users/{uid}/settings/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid && licensed();
    }

    // ===== BIP Absensi =====
    // Lisensi akun BIP dipisah dari Rekap OS (koleksi licenses_bip). Akun kedaluwarsa juga ditolak di sini.
    function licensedBip() {
      let p = /databases/$(database)/documents/licenses_bip/$(myEmail());
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(p)
        && get(p).data.status == 'active'
        && (!('expiresAt' in get(p).data) || get(p).data.expiresAt == null || request.time < get(p).data.expiresAt);
    }
    match /licenses_bip/{email} {
      allow read: if request.auth != null && (isAdmin() || myEmail() == email);
      allow write: if isAdmin();
    }
    match /users/{uid}/bip_settings/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid && licensedBip();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
